rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Audit logs: append-only, cannot be edited or deleted (anti-tamper)
    match /audit_logs/{logId} {
      allow read, create: if true;
      allow update, delete: if false;
    }

    // All school data, users, teachers, students, classrooms, subjects, assignments, and grades
    // Allow read & write to enable seamless real-time synchronization across all devices (PC, Laptop, HP, Vercel)
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
